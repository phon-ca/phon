            <extensions>
                <oga:settings>
                    <oga:property key="__script"><![CDATA[var TierList = require("lib/TierList");

var reportTitleParamInfo = {
	"id": "reportTitle",
	"title": "Report Title",
	"def": "Index of Phonetic Complexity",
	"prompt": "Enter report title"
};
var reportTitleParam;
var reportTitle = reportTitleParamInfo.def;

var tier1 = "IPA Target";
var tier2 = "IPA Actual";
var includeDifference = true;

function init(inputs, outputs) {
	outputs.add("tierNames", "Tier names to include in report, each should be a table column name", false, java.lang.String);
	outputs.add("includeDifference", "Include differences between tiers scores (if two tiers names have been provided.)", false, java.lang.Boolean);
}

function run(context) {
}

function setup_params(params) {
	reportTitleParam = new StringScriptParam(
		reportTitleParamInfo.id,
		reportTitleParamInfo.title,
		reportTitleParamInfo.def);
     reportTitleParam.setPrompt(reportTitleParamInfo.prompt);
	params.add(reportTitleParam);

	var sep = new SeparatorScriptParam("IPC Options", false);
	params.add(sep);
}
]]></oga:property>
